# Application
APP_NAME=Personal Finance API
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_finance
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_finance_test

# JWT authentication
# Replace this local-only placeholder with a long random value in any deployed environment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
